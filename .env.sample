# LLM Council Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED
# =============================================================================

# OpenRouter API key - get one at https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-...

# API key for backend API auth (users enter their own key in the UI).
API_AUTH_KEY=llm-council-local-...

# Frontend API base URL (optional).
VITE_API_BASE=http://localhost:8001

# =============================================================================
# MODELS (all optional, defaults shown)
# =============================================================================

# Council models - comma-separated list of OpenRouter model identifiers.
COUNCIL_MODELS=openai/gpt-5.2,google/gemini-3-pro-preview,anthropic/claude-opus-4.5,x-ai/grok-4.1-fast,moonshotai/kimi-k2.5,deepseek/deepseek-v3.2

# Chairman model - synthesizes the final response.
CHAIRMAN_MODEL=google/gemini-3-pro-preview

# Model for prompt refinement (defaults to chairman model).
PROMPT_REFINEMENT_MODEL=google/gemini-3-pro-preview

# Model for generating conversation titles.
TITLE_MODEL=google/gemini-2.5-flash

# =============================================================================
# RUNTIME (all optional, defaults shown)
# =============================================================================

# OpenRouter API endpoint.
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# OpenRouter retry settings.
OPENROUTER_MAX_RETRIES=2
OPENROUTER_RETRY_BASE_SECONDS=0.5
OPENROUTER_RETRY_MAX_SECONDS=8.0
OPENROUTER_RETRY_JITTER=0.2

# OpenRouter response length limit (max tokens generated per request).
OPENROUTER_MAX_TOKENS=10000

# Prompt length limits (characters).
MAX_PROMPT_CHARS=15000
MAX_NEGATIVE_PROMPT_CHARS=15000

# Data directory for conversation storage.
DATA_DIR=data/conversations

# CORS allowlist for the backend API (comma-separated).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Timeout for interactive prompts in seconds.
INTERACTIVE_TIMEOUT_SECONDS=300

# Client-side streaming timeout in seconds.
STREAM_TIMEOUT_SECONDS=600

# =============================================================================
# FEATURE FLAGS (all optional, default to false)
# =============================================================================

# Enable gap-finding evaluations where models score responses for missing
# risks, blind spots, and edge cases. Adds latency but improves quality.
NEGATIVE_MODE_ENABLED=false

# Enable deliberation round where models see peer rankings and gap feedback,
# then submit revised responses. Single revision round per model.
DELIBERATION_ENABLED=false

# Enable interactive mode with inline user prompts during processing.
# Prompts appear at key stages: pre-query config, response review, synthesis preferences.
# Processing waits indefinitely for user response at each prompt.
INTERACTIVE_MODE_ENABLED=false

# Enable optional prompt refinements for decision-support synthesis.
# When enabled, interactive config and decision-support guidance will shape rankings and synthesis.
PROMPT_REFINEMENT_ENABLED=false

# Enable pairwise ranking aggregation using the Schulze method (Condorcet voting).
# More resistant to outlier rankings than simple average-position scoring.
PAIRWISE_RANKING_ENABLED=false
