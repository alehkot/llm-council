# LLM Council Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED
# =============================================================================

# OpenRouter API key - get one at https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-...

# API key for backend API auth (users enter their own key in the UI).
API_AUTH_KEY=llm-council-local-...

# Frontend API base URL (optional).
VITE_API_BASE=http://localhost:8001

# =============================================================================
# MODELS (all optional, defaults shown)
# =============================================================================

# Council models - comma-separated list of OpenRouter model identifiers.
COUNCIL_MODELS=openai/gpt-5.6-sol,google/gemini-3.7-flash,anthropic/claude-opus-5,x-ai/grok-4.6,moonshotai/kimi-k3,deepseek/deepseek-v4-pro-0813

# Chairman model - synthesizes the final response.
CHAIRMAN_MODEL=openai/gpt-5.6-sol

# Model for prompt refinement (defaults to chairman model).
PROMPT_REFINEMENT_MODEL=google/gemini-3.7-flash

# Model for generating conversation titles.
TITLE_MODEL=google/gemini-3.7-flash

# =============================================================================
# RUNTIME (all optional, defaults shown)
# =============================================================================

# OpenRouter API endpoint.
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# OpenRouter retry settings.
OPENROUTER_MAX_RETRIES=2
OPENROUTER_RETRY_BASE_SECONDS=0.5
OPENROUTER_RETRY_MAX_SECONDS=8.0
OPENROUTER_RETRY_JITTER=0.2

# OpenRouter response length limit (max tokens generated per request).
OPENROUTER_MAX_TOKENS=10000

# Prompt length limits (characters).
MAX_PROMPT_CHARS=15000
MAX_NEGATIVE_PROMPT_CHARS=15000

# Data directory for conversation storage.
DATA_DIR=data/conversations

# CORS allowlist for the backend API (comma-separated).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Timeout for interactive prompts in seconds.
INTERACTIVE_TIMEOUT_SECONDS=300

# Client-side streaming timeout in seconds.
STREAM_TIMEOUT_SECONDS=600

# =============================================================================
# FEATURE FLAGS (all optional, default to false)
# =============================================================================

# Enable gap-finding evaluations where models score responses for missing
# risks, blind spots, and edge cases. Adds latency but improves quality.
NEGATIVE_MODE_ENABLED=false

# Enable deliberation round where models see peer rankings and gap feedback,
# then submit revised responses. Single revision round per model.
DELIBERATION_ENABLED=false

# Enable interactive mode with inline user prompts during processing.
# Prompts appear at key stages: pre-query config, response review, synthesis preferences.
# Processing waits indefinitely for user response at each prompt.
INTERACTIVE_MODE_ENABLED=false

# Enable optional prompt refinements for decision-support synthesis.
# When enabled, interactive config and decision-support guidance will shape rankings and synthesis.
PROMPT_REFINEMENT_ENABLED=false

# Enable pairwise ranking aggregation using the Schulze method (Condorcet voting).
# More resistant to outlier rankings than simple average-position scoring.
PAIRWISE_RANKING_ENABLED=false

# =============================================================================
# AGENT SKILLS (all optional, defaults shown)
# =============================================================================
# Uploadable Agent Skills - a zipped SKILL.md bundle whose instructions are
# injected into the Stage 1 council prompts and the Stage 3 chairman prompt.
# Note: unlike the feature flags above, SKILLS_ENABLED defaults to TRUE. Skills
# cost nothing until one is uploaded and selected for a consultation.
# Uploaded bundles are stored under data/skills/, which is gitignored along with
# the rest of data/. There is no separate directory setting - DATA_DIR moves it.

# Master switch. When false the /api/skills routes are not registered at all
# and no skill context is ever injected into a prompt.
SKILLS_ENABLED=true

# Max size in bytes of an uploaded .zip (5 MiB).
SKILLS_UPLOAD_MAX_BYTES=5242880

# Max number of entries allowed inside an uploaded .zip.
SKILLS_MAX_ENTRIES=500

# Max total uncompressed size in bytes of an uploaded .zip (20 MiB).
SKILLS_MAX_UNCOMPRESSED_BYTES=20971520

# Max per-entry uncompressed/compressed ratio before the upload is rejected
# as a zip bomb.
SKILLS_MAX_COMPRESSION_RATIO=100

# Max number of skills selectable for a single consultation.
SKILLS_MAX_SELECTED=5

# Max number of references/*.md documents the selector may draw sections from.
SKILLS_MAX_REFERENCES=4

# Max number of heading-delimited reference sections inlined in total.
# Selecting every section of a document equals inlining the whole file.
SKILLS_MAX_REFERENCE_SECTIONS=12

# Character budget for the skills block in the Stage 1 council prompts.
SKILLS_CONTEXT_MAX_CHARS=48000

# Character budget for the skills block in the Stage 3 chairman prompt.
# Must be <= SKILLS_CONTEXT_MAX_CHARS.
SKILLS_SYNTHESIS_CONTEXT_MAX_CHARS=24000

# Use a cheap model to pick which references/*.md a query needs. When false, a
# deterministic keyword-overlap fallback picks them with no extra model call.
SKILLS_REFERENCE_SELECTION_ENABLED=true

# Model used for that reference-selection call (defaults to
# PROMPT_REFINEMENT_MODEL, which itself defaults to the chairman model).
SKILLS_REFERENCE_SELECTION_MODEL=openai/gpt-5.6-luna

# Auto-select skills when a consultation is sent with no skills ticked in the
# composer: up to SKILLS_MAX_SELECTED enabled skills whose description matches
# the question. Explicit picks always win. Off by default (operator-driven).
SKILLS_AUTO_SELECT_ENABLED=false

# Model used for that skill-selection call (defaults to
# SKILLS_REFERENCE_SELECTION_MODEL).
#SKILLS_AUTO_SELECT_MODEL=openai/gpt-5.6-luna
