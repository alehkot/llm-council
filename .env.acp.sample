# Local agent council. Merge into .env; preserve your real API_AUTH_KEY.
# Install with: uv sync && npm ci --prefix agent-adapters
# Sign in as the backend's OS user:
# ./agent-adapters/node_modules/.bin/codex login
# Antigravity: native Google AI Pro/Ultra login on macOS; install the official
# ACP 1.4.5 runtime and matching helper as described in README.md.
# Pi: ./agent-adapters/node_modules/.bin/pi, then /login and select OpenRouter.
# The explicit Pi/OpenRouter member below uses its stored API key and is API billed.
MODEL_BACKEND=acp
API_AUTH_KEY=replace-with-your-local-backend-key
COUNCIL_MODELS=agy/gemini-3.8-flash,codex/gpt-6-astra,pi/openrouter/deepseek/deepseek-v4.1-flash-1017
CHAIRMAN_MODEL=codex/gpt-6-astra
# Subscription-only alternative (requires a Pi OpenAI OAuth login):
# COUNCIL_MODELS=codex/default,pi/openai-codex/gpt-5.6-sol
# Claude is also supported after native `claude auth login`: claude/default.

# These must also use ACP IDs if present in an existing .env.
PROMPT_REFINEMENT_MODEL=codex/gpt-6-astra
TITLE_MODEL=codex/gpt-6-astra
SKILLS_REFERENCE_SELECTION_MODEL=codex/gpt-6-astra
SKILLS_AUTO_SELECT_MODEL=codex/gpt-6-astra

# ACP mode always uses ACP synthesis and disables the paid TypeSafe router.
# Application OpenRouter/TypeSafe environment keys are not sent to agents.
# Pi's explicit OpenRouter route reads its own native stored credential.
SYNTHESIS_AGENT_DIR=data/synthesis
SYNTHESIS_AGENT_TIMEOUT_SECONDS=1800
