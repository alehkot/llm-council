# Subscription-backed council. Merge into .env; preserve your real API_AUTH_KEY.
# Install with: uv sync && npm ci --prefix agent-adapters
# Sign in as the backend's OS user:
# ./agent-adapters/node_modules/.bin/codex login
# claude auth login (requires the native Claude Code CLI)
MODEL_BACKEND=acp
API_AUTH_KEY=replace-with-your-local-backend-key
COUNCIL_MODELS=codex/default,claude/default
CHAIRMAN_MODEL=codex/default

# These must also use ACP IDs if present in an existing .env.
PROMPT_REFINEMENT_MODEL=codex/default
TITLE_MODEL=codex/default
SKILLS_REFERENCE_SELECTION_MODEL=codex/default
SKILLS_AUTO_SELECT_MODEL=codex/default

# ACP mode always uses ACP synthesis and disables the paid TypeSafe router.
# OpenRouter and TypeSafe keys are not required or sent to agents.
SYNTHESIS_AGENT_DIR=data/synthesis
SYNTHESIS_AGENT_TIMEOUT_SECONDS=1800
